#!/usr/bin/env bash
# mapnik-config shim for a source-built Mapnik installed under /usr/local.
#
# node-mapnik's binding.gyp drives its entire build off `mapnik-config`, but
# Mapnik's CMake build does not generate one. This shim emits the *exact*
# compile flags libmapnik was built with (see compile_commands.json from the
# Mapnik build) so the node-mapnik binding compiles Mapnik's headers with
# matching defines/ABI. Keep the defines in sync if the Mapnik build options
# change.
set -eu

PREFIX=/usr/local
LIBDIR="$PREFIX/lib"
INCDIR="$PREFIX/include"

# Defines taken verbatim from the libmapnik build, minus the dllexport macros
# (MAPNIK_EXPORTS / mapnik_EXPORTS) which only apply when *building* libmapnik.
DEFINES="-DBIGINT -DBOOST_REGEX_DYN_LINK -DBOOST_REGEX_HAS_ICU -DBOOST_REGEX_NO_LIB \
-DGRID_RENDERER -DHAVE_AVIF -DAVIF_DLL -DHAVE_CAIRO -DHAVE_JPEG -DHAVE_LIBXML2 \
-DHAVE_PNG -DHAVE_TIFF -DHAVE_WEBP -DMAPNIK_HAS_DLCFN -DMAPNIK_MEMORY_MAPPED_FILE \
-DMAPNIK_PROJ_VERSION=90400 -DMAPNIK_THREADSAFE -DMAPNIK_USE_PROJ -DSVG_RENDERER -DNDEBUG"

# node-mapnik sources directly include cairo.h, ft2build.h, unicode/*.h, libxml.
# Pull their include dirs from pkg-config so the binding compiles against the
# same system deps libmapnik was built with.
DEP_INCLUDES="$(pkg-config --cflags-only-I cairo freetype2 libxml-2.0 icu-uc 2>/dev/null || true)"
# agg headers install under <prefix>/include/mapnik/agg (matches the upstream
# mapnik-config template).
INCLUDES="-I$INCDIR -I$INCDIR/mapnik/agg $DEP_INCLUDES"
CXXFLAGS="-std=c++20"

usage() { echo "mapnik-config shim"; exit "${1:-0}"; }
[ $# -eq 0 ] && usage 1

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage 0 ;;
    -v|--version) echo "4.2.3" ;;
    --version-number) echo "402003" ;;
    --git-revision) echo "5da75580d830d183ec4458b2b9d898dc744cae75" ;;
    --git-describe) echo "unbuffered-bbox" ;;
    --prefix) echo "$PREFIX" ;;
    --lib-name) echo "mapnik" ;;
    --fonts) echo "$LIBDIR/mapnik/fonts" ;;
    --input-plugins) echo "$LIBDIR/mapnik/input" ;;
    --defines) printf '%s' "$DEFINES" ;;
    --includes) printf '%s' "$INCLUDES" ;;
    --dep-includes) printf '%s' "" ;;
    --cxxflags) printf '%s' "$CXXFLAGS" ;;
    --cflags) printf '%s %s %s' "$CXXFLAGS" "$DEFINES" "$INCLUDES" ;;
    --libs) printf '%s' "-L$LIBDIR -lmapnik" ;;
    --dep-libs) printf '%s' "-licui18n -licuuc -lboost_regex" ;;
    --ldflags) printf '%s' "-L$LIBDIR -Wl,-rpath,$LIBDIR" ;;
    --cxx) echo "c++" ;;
    --all-flags) printf '%s %s %s -L%s -lmapnik' "$CXXFLAGS" "$DEFINES" "$INCLUDES" "$LIBDIR" ;;
    --gdal-data) echo "/usr/share/gdal" ;;
    --proj-lib) echo "/usr/share/proj" ;;
    --icu-data) echo "" ;;
    *) : ;;
  esac
  shift
  [ $# -gt 0 ] && printf ' '
done
echo
